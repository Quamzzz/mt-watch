# Shared secret the MT box sends in the Authorization header. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BEAT_TOKEN=replace-me

# Railway sets this for you when you add a Postgres service and reference it as
# ${{Postgres.DATABASE_URL}}. Locally, point it at any Postgres you like.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# How long the box may go silent before the cron service calls it dead.
SILENT_AFTER_S=1800

# Only the cron service needs these. Same bot as MT; the chat id is the one MT
# already learned when you sent it /start.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Railway sets PORT itself. Do not define it.
